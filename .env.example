# MAT-BOT — primjer .env fajla za VPS (docker compose čita ./.env kroz env_file).
# Kopiraj u .env i popuni STVARNE vrijednosti. NIKAD ne commituj pravi .env.

# ── Obavezno ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-REPLACE_ME
# Secret za potpisivanje kratkotrajnog embed_token-a (matbot/auth.py).
# FLASK_SECRET_KEY je PRIMARNI naziv za trenutni minimalni backend. SECRET_KEY
# je kompatibilni ALIAS — ako produkcijski VPS već ima SECRET_KEY postavljen
# iz ranije faze, app.py ga i dalje prihvata (nema potrebe mijenjati postojeći
# .env na VPS-u). Ako su OBA postavljena, FLASK_SECRET_KEY ima prednost.
# Ako NIJEDAN nije postavljen, app.py namjerno odbija start (vidi
# matbot/config.py: require_secret_key). Postavi SAMO JEDAN od njih:
FLASK_SECRET_KEY=REPLACE_ME_random_64_hex          # npr. `openssl rand -hex 32`
# SECRET_KEY=REPLACE_ME_random_64_hex              # alternativa/alias — koristi SAMO ako VPS već ovo ima

# ── Security hardening trenutnog minimalnog backenda (matbot/) ─────────────
# Kratkotrajni potpisani token koji GET / kuje i frontend šalje kao
# X-Tutor-Token na svaki /api/ai-tutor/* poziv (anonimna zaštita API-ja od
# direktnih poziva bez učitavanja stranice — NE Thinkific identitet).
MATBOT_TOKEN_TTL_SECONDS=7200
# Rate limiting (in-memory, bez Redis-a) — dva nivoa, oba podesiva.
# Po anonimnoj session_id (localStorage UUID iz browsera):
MATBOT_SESSION_LIMIT_PER_MINUTE=15
MATBOT_SESSION_LIMIT_PER_HOUR=150
# Po IP adresi (viši plafon — više učenika iza iste školske/kućne mreže):
MATBOT_IP_LIMIT_PER_MINUTE=120
MATBOT_IP_LIMIT_PER_HOUR=1000
# Ograničenja ulaza za /api/ai-tutor/chat i /chat/stream:
MATBOT_MAX_MESSAGE_CHARS=3000
MATBOT_MAX_HISTORY_ITEMS=6
MATBOT_MAX_HISTORY_CHARS_PER_ITEM=3000

# ── Izvještajna baza (Turso/libSQL) — SAMO identitet učenika ────────────
# Prvi podsistem MAT-BOT-a koji piše van procesa (matbot/reporting_db.py).
# Obje vrijednosti moraju postojati — polovična konfiguracija znači ISKLJUČENO,
# nikad „pokušaj bez tokena“. Dok su prazne, MAT-BOT radi potpuno normalno i ne
# pokušava nijednu konekciju; nijedan tutorski mod ne zavisi od ove baze.
#
# TAJNA JE `TURSO_AUTH_TOKEN`. Ne ide u repozitorij, NE ide u
# deploy/production_release.env (taj fajl je u gitu) i ne ispisuje se ni u
# jednom logu. Provjera nakon postavljanja (samo čitanje, ne mijenja podatke):
#   docker compose exec -T matbot python -m matbot.reporting_db --check
TURSO_DATABASE_URL=libsql://REPLACE_ME.turso.io
TURSO_AUTH_TOKEN=REPLACE_ME_turso_token
# Rok jedne izvještajne operacije (sekunde) i broj istovremenih operacija.
# Prazno = ugrađene vrijednosti (2.0 s, 2 u letu). Bez retryja — jedan pokušaj.
MATBOT_REPORTING_DB_TIMEOUT_S=2.0
MATBOT_REPORTING_DB_MAX_INFLIGHT=2

# ── Privatna administratorska stranica izvještaja (Faza 3B) ───────────
# Lozinka za `/admin/reports` — stranica prikazuje napredak stvarnih učenika i
# NIJE javna. PRAZNO ILI KRAĆE OD 12 ZNAKOVA = STRANICA JE POTPUNO ISKLJUČENA
# (sve njene rute vraćaju 404). To je namjerno: zaboravljena varijabla ne smije
# otvoriti stranicu svakome.
# Generiši: `openssl rand -base64 24`
MATBOT_ADMIN_PASSWORD=REPLACE_ME_dugacka_admin_lozinka
# Kolačić sesije je podrazumijevano `Secure` (produkcija radi preko HTTPS-a).
# `disabled` je SAMO za lokalni http razvoj — nikad u produkciji.
# MATBOT_ADMIN_COOKIE_SECURE=disabled

# ── Sigurnost STARE (uklonjene) verzije backenda — donji blok NIJE korišten
# trenutnim kodom u matbot/. Zadržan kao referenca dok se ne odluči da li se
# neki od ovih mehanizama (Thinkific origin gate, CORS, CSP) vraća u novoj fazi.
# ULAZ SAMO KROZ THINKIFIC — tri barijere koje rade zajedno; postavi SVE TRI:
#
# 1) EMBED_ALLOWED_ORIGINS — ko smije OTVORITI aplikaciju (GET /).
#    Bez odgovarajućeg Referer/Origin: 403 i token se NE kuje, pa je i tutor API
#    nedostupan. Prazno = kapija ISKLJUČENA (svako ko zna URL uđe). Wildcard radi.
EMBED_ALLOWED_ORIGINS=https://*.thinkific.com
# 2) AI_TUTOR_EMBED_SECRET — bez njega tutor API prolazi svakoga (kapija tada
#    štiti samo stranicu). Generiši: `openssl rand -hex 32`.
AI_TUTOR_EMBED_SECRET=REPLACE_ME_random_64_hex
# 3) FRAME_ANCESTORS — CSP: ko nas smije staviti u iframe. Prazno = bez CSP headera.
FRAME_ANCESTORS=https://*.thinkific.com
#
# Dozvoljeni CORS origini, zarezom odvojeni. Prazno = SVE domene (startup warning).
CORS_ORIGINS=https://tvoja-skola.thinkific.com,https://www.matematicari.com
# Tajna za /tasks/process (Cloud Tasks async tok). Prazno = endpoint odbija sve.
TASKS_SECRET=
# Token za dijagnostičke endpointe (/sheets/diag, /mathpix/selftest...). Prazno = zatvoreni.
DIAG_TOKEN=
# AI_TUTOR_EMBED_SECRET je gore, uz ostale barijere (vidi docs/deploy/embed-token.md).
AI_TUTOR_TOKEN_TTL_S=7200

# ── OpenAI modeli i vremena ─────────────────────────────────────────────────
OPENAI_MODEL_TEXT=gpt-5-mini
OPENAI_MODEL_VISION=gpt-5.2
OPENAI_TIMEOUT=120                                  # legacy /submit putanja
AI_TUTOR_TIMEOUT=45                                 # modularni tutor (kraće — učenik čeka)
AI_TUTOR_MAX_RETRIES=1
OPENAI_MAX_RETRIES=2

# ── Practice put — OBAVEZNE RELEASE VARIJABLE ───────────────────────────────
# NE PREPISUJ IH RUČNO NA VPS-u. Cijeli obavezni skup živi u
# deploy/production_release.env i deploy workflow ga upisuje u .env pri SVAKOM
# izdanju; matbot/release_config.py ga zatim provjerava i pada zatvoreno.
# Vrijednosti ispod su tu samo da bi primjer bio potpun i čitljiv.
#
# ZAŠTO SU OBAVEZNE, A NE OPCIONE: produkcija je jednom radila BEZ prve dvije,
# dok su gate-ovi mjerili obje uključene. Sve je izgledalo zdravo, a mjeren je
# jedan put dok se izvršavao drugi — klik na MCQ opciju je proradio tek kad su
# varijable dodane i kontejner ponovo kreiran. Poređenje je EGZAKTNO: „nije
# prazno“ ili „liči na tačno“ je upravo ono što je propustilo taj kvar.
#
# NAPOMENA O TROŠKU: univerzalni put troši DVA modela poziva po turnu i traži
# veći frontend timeout (vidi TUTOR_ABORT_MS u templates/index.html).
MATBOT_PRACTICE_PIPELINE=universal_two_call
MATBOT_PRACTICE_DIFFICULTY_LEVELS=enabled
MATBOT_REASONING_EFFORT=low
# Rollback ručke Practice ponašanja. Ugrađena vrijednost je već produkcijska;
# deploy ih upisuje izričito da bi se auditirano stanje VIDJELO u logu i vratilo
# poslije svake ručne intervencije.
MATBOT_DETERMINISTIC_PRACTICE=enabled
MATBOT_PRACTICE_SINGLE_HINT=enabled
MATBOT_ARCHETYPE_ROTATION=enabled
MATBOT_FORM_ROTATION=enabled
# Prekidač zatvorenog pada. Prazno/odsutno (lokalni run, testovi) = start samo
# upozorava. `enabled` (produkcija) = start ODBIJA pogrešnu konfiguraciju.
MATBOT_RELEASE_ENFORCEMENT=enabled

# Budžet izlaznih tokena recenzenta (drugi poziv). Prazno = 3200, izmjereno u
# Fazi 4F; vidi matbot/config.py. Dozvoljeno 1500–4000.
# MATBOT_MAX_OUTPUT_TOKENS_REVIEWER=3200

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=1
RATE_LIMIT_SUBMIT=30 per minute                     # po IP-u; škole iza NAT-a → povećaj

# ── Mathpix OCR (opciono; prazno = OCR isključen, ide Vision) ────────────────
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# ── Google Sheets — puna transkripcija tutor razgovora (opciono) ─────────────
GSHEET_ID=
GSHEET_NAME=matematika-bot
GOOGLE_SHEETS_CREDENTIALS_B64=
SHEETS_ASYNC_LOG=1

# ── VPS/Docker ───────────────────────────────────────────────────────────────
PORT=8080
WEB_CONCURRENCY=1        # PAŽNJA: >1 workera + in-memory job store = async jobovi se gube
THREADS=8
GUNICORN_TIMEOUT=120
USE_FIRESTORE=0          # na VPS-u nema GCP kredencijala; jobovi idu u memoriju
COOKIE_SECURE=1
MAX_CONTENT_LENGTH_MB=20
IMAGE_FETCH_MAX_MB=20
# SQLite activity log (metapodaci tutora). Default: storage/matbot.sqlite3
# MATBOT_DB_PATH=/app/storage/matbot.sqlite3
# APP_VERSION postavlja deploy workflow automatski (git SHA).
# APP_VERSION=dev

# Brza Practice ruta. UGRAĐENA vrijednost u matbot/config.py je `lessons`
# (pilot), pa je produkcijska vrijednost OBAVEZNA — prazno ovdje ne znači
# „auditirano“, nego ugašenu brzu rutu. Upisuje je deploy.
#   model_backed = svaka modelski podržana lekcija ide brzom rutom (PRODUKCIJA)
#   lessons      = samo lekcije iz MATBOT_FAST_SINGLE_CALL_LESSONS
#   off          = potpuni rollback na univerzalni dvopozivni put
MATBOT_FAST_SINGLE_CALL_SCOPE=model_backed
# Izuzimanje pojedinačne lekcije unutar opsega (rollback bez gašenja rute).
MATBOT_FAST_SINGLE_CALL_EXCLUDE=
# Kapija mjerene raznolikosti determinističkih porodica. Ugrađeno je
# `disabled` (potpun rollback), pa je i ova vrijednost OBAVEZNA: bez `enabled`
# produkcija servira 19 mjereno slabih porodica determinističkim generatorima
# umjesto Luna rutom — dakle drugu rutu nego što je auditirano.
MATBOT_DETERMINISTIC_VARIETY_GATE=enabled
