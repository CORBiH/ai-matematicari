# JEDAN IZVOR ISTINE o obaveznoj produkcijskoj konfiguraciji MAT-BOT-a.
#
# ZAŠTO POSTOJI OVAJ FAJL, A NE PET SPISKOVA: ista lista se ranije ponavljala u
# `matbot/release_config.py`, u deploy workflowu, u kapiji izdanja i u
# testovima. Četiri kopije jedne odluke znače da tri mogu zaostati, i upravo se
# to desilo: deploy je upisivao opseg brze rute i kapiju raznolikosti, ali NE i
# `MATBOT_PRACTICE_PIPELINE`; kapija izdanja je tražila samo dvije od pet
# vrijednosti, pa je zvanično mjerenje prošlo s rokom od 30 s dok produkcija
# radi na 45 s. Otud ovaj fajl: čitaju ga i Python i shell, pa nova vrijednost
# ima tačno jedno mjesto.
#
# FORMAT: `KLJUC=vrijednost`, jedan par po redu; prazan red i `#` su komentar.
# Namjerno bez navodnika, razmaka oko `=` i bez interpolacije — deploy ga čita
# običnom shell petljom, bez `jq` i bez `source`.
#
# VRIJEDNOSTI SU OGRANIČENE NA `[A-Za-z0-9_.:+-]` (dokazano testom). Deploy ih
# ubacuje u `.env` kroz `sed`, pa bi `&`, `|` ili `\` u vrijednosti bili
# protumačeni kao zamjenska sintaksa umjesto kao tekst.
#
# OVDJE NE SMIJE NIKAD DOĆI NIJEDNA TAJNA. Fajl je u repozitoriju. Ključevi i
# potpisni secreti žive isključivo u produkcijskom `.env` na VPS-u; njih deploy
# niti čita niti dira.

# ── Arhitektura Practice puta ───────────────────────────────────────────────
# `MATBOT_PRACTICE_PIPELINE` je OVDJE NAMJERNO NESTAO (povlačenje 2026-08-14).
# Birao je između univerzalnog puta i starog jednopozivnog motora; taj motor je
# uklonjen iz koda, pa varijabla više nema šta da bira. Zaostala vrijednost u
# produkcijskom `.env`-u je bezopasna jer je NIKO VIŠE NE ČITA — stari put se
# ne može oživjeti konfiguracijom, samo vraćanjem starog commita.
MATBOT_PRACTICE_DIFFICULTY_LEVELS=enabled

# ── Ruta modelski podržanih lekcija ─────────────────────────────────────────
# UGRAĐENA vrijednost u `matbot/config.py` je `lessons` (pilot), i to namjerno:
# `model_backed` u kodu bi cijelu testnu svitu prevelo na brzu rutu i ugasilo
# dokaze univerzalnog dvopozivnog puta koji ostaje rollback. Zato produkcijsku
# vrijednost MORA upisati deploy — odsustvo ovdje znači da brza ruta ne radi.
MATBOT_FAST_SINGLE_CALL_SCOPE=model_backed

# ── Kapija mjerene raznolikosti determinističkih porodica ───────────────────
# Ugrađena vrijednost je `disabled` (potpun rollback). Bez `enabled` produkcija
# servira 19 mjereno slabih porodica determinističkim generatorima umjesto da
# ih pusti na Luna rutu — dakle DRUGU rutu nego što je auditirano.
MATBOT_DETERMINISTIC_VARIETY_GATE=enabled

# ── Rollback ručke čija je ugrađena vrijednost već produkcijska ─────────────
# Ove četiri ne mogu tiho odlutati IZOSTANKOM (ugrađeno = produkcijsko), ali
# mogu ostati zaboravljene nakon ručne intervencije na VPS-u. Zato ih deploy
# izričito vraća na auditirano stanje pri svakom izdanju: namjeran rollback je
# izmjena OVOG fajla i novo izdanje, nikad nedokumentovan `.env` na serveru.
MATBOT_DETERMINISTIC_PRACTICE=enabled
MATBOT_PRACTICE_SINGLE_HINT=enabled
MATBOT_ARCHETYPE_ROTATION=enabled
MATBOT_FORM_ROTATION=enabled

# ── Model i vrijeme ─────────────────────────────────────────────────────────
# `OPENAI_MODEL_TEXT` je model REZERVNOG univerzalnog dvopozivnog puta i
# Explain/Quick turnova — nije Luna. Luna se bira ugrađenom vrijednošću (vidi
# napomenu o `MATBOT_FAST_*` na dnu).
OPENAI_MODEL_TEXT=gpt-5-mini
MATBOT_REASONING_EFFORT=low
# Rok jednog modelskog poziva. Kapija izdanja koristi ISTU vrijednost — ranije
# je mjerila 30 s (ugrađena vrijednost) dok produkcija radi na 45 s.
AI_TUTOR_TIMEOUT=45

# ── Prekidač zatvorenog pada ────────────────────────────────────────────────
# `enabled` znači: aplikacija odbija start kad bilo koja vrijednost iznad
# odstupa. Postoji da bi lokalni rad i testovi ostali mogući BEZ produkcijskih
# zastavica — bez ovog prekidača bi svako pokretanje van produkcije padalo.
# Njegovo odsustvo u produkciji hvata izričit deploy korak, koji provjeru zove
# bezuslovno, pa se ni sam prekidač ne može tiho izgubiti.
MATBOT_RELEASE_ENFORCEMENT=enabled

# ── NAMJERNO IZOSTAVLJENO: izbor brzog modela ───────────────────────────────
# `MATBOT_FAST_MODEL`, `MATBOT_FAST_REASONING_EFFORT` i
# `MATBOT_FAST_REVIEWER_MODEL` NISU ovdje, i to je odluka, ne propust:
#
#   • auditirana vrijednost je već UGRAĐENA u `matbot/config.py`, pa bi upis u
#     `.env` napravio drugo mjesto koje može odlutati od koda — a `.env` bi
#     nadjačao buduću izmjenu koda koja je prošla kapiju izdanja;
#   • `MATBOT_FAST_REVIEWER_MODEL` se namjerno IZVODI iz `MATBOT_FAST_MODEL`;
#     pribijanje u `.env` bi tu vezu prekinulo pri sljedećoj promjeni modela.
#
# Pogrešna vrijednost ipak pada zatvoreno: provjera poredi EFEKTIVNO razriješen
# izbor modela (`release_config.REQUIRED_EFFECTIVE_CONFIG`), što hvata i
# pogrešnu env varijablu i neovlaštenu izmjenu ugrađene vrijednosti.
